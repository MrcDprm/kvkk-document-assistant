# Never commit real values.
# Groq (https://console.groq.com/keys): answers questions first, fast and with a larger free quota.
GROQ_API_KEY=
# Google AI Studio (https://aistudio.google.com/apikey): fallback answers and embeddings.
GEMINI_API_KEY=

# Optional (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# SESSION_TTL_SECONDS=1800
# MAX_SESSIONS=200
# MAX_UPLOAD_BYTES=10485760
# MAX_TEXT_CHARS=100000
# NER_MODEL_DIR=models/ner
# NER_THREADS=1
# ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 0 only for local development over plain http
# COOKIE_SECURE=1
